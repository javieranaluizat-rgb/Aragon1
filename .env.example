# Copia este archivo como .env.local y completa los valores.

# Nombre que aparece en la app
CONJUNTO_NOMBRE="Samara III"

# Cuenta bancaria del conjunto (se usa para verificar que el comprobante
# se haya hecho a la cuenta correcta). Basta con el número de cuenta.
CONJUNTO_BANCO="Banco Pichincha"
CONJUNTO_CUENTA="2200000000"

# Contraseña del panel de administración (cámbiala).
ADMIN_PASSWORD="cambia-esta-clave"
# Texto largo al azar para firmar la sesión del administrador.
SESSION_SECRET="pon-aqui-un-texto-largo-y-aleatorio"

# Clave de la API de Claude (https://console.anthropic.com) para leer
# comprobantes y estados de cuenta en PDF. Sin ella, la app funciona pero
# el residente debe escribir los datos a mano.
ANTHROPIC_API_KEY=""

# Base de datos PostgreSQL (Supabase, Neon, etc.). Si se deja vacío, la app
# usa una base de datos local en la carpeta .data/ (solo para pruebas).
DATABASE_URL=""

# Crear casas de ejemplo (1 a 20) la primera vez. Pon "false" en producción
# si vas a cargar las casas reales tú mismo.
SEMBRAR_CASAS_DEMO="true"
